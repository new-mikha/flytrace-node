# Copy to .env and adjust. The dev DB name must contain "_dev" for `npm run db:reset` to be allowed.
# An address, not localhost: on macOS the name lookup of a new connection sometimes stalls for 5 seconds.
DATABASE_URL=postgres://flytrace:flytrace@127.0.0.1:5433/flytrace_dev
PORT=3000
# 32+ random chars; `openssl rand -base64 48`
SESSION_SECRET=change-me-change-me-change-me-change-me-change-me
# Time zone of the log times and of the times shown on pages, e.g. Europe/Berlin or UTC. Empty: the host's time zone.
LOG_TIMEZONE=
# Comma-separated usernames to skip when importing the legacy dump (non-unique emails)
LEGACY_EXCLUDE_USERS=zawad20
# API key for db/legacy/dump-all-tables.sh (pulls a fresh dump from the old site)
#FLYTRACE_DUMP_API_KEY=

# --- Accounts and email ---
# The session cookie is Secure (HTTPS only) in production. Set false only to try the site over plain HTTP, e.g. on a home network.
#COOKIE_SECURE=false
# Public address of the site, used in the links inside emails. Set it in production.
#PUBLIC_BASE_URL=https://www.flytrace.com
# true: users must click the link in the confirmation email before they can log in. Needs working SMTP.
REQUIRE_CONFIRMED_EMAIL=false
# Outgoing email (any SMTP service, e.g. a free tier of Brevo / SMTP2GO / Mailjet / Gmail app password).
# While SMTP_HOST is empty nothing is sent: each message is printed in the server log, links included.
SMTP_HOST=
# 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Flytrace
# The address for questions, shown in emails and in the privacy policy
MAIL_CONTACT_ADDRESS=info@flytrace.com

# --- Map ---
# Google Maps JavaScript API. Both are needed in production: a browser key (Google Cloud console, "Maps JavaScript API",
# needs a billing account) restricted by HTTP referrer to the addresses the site is served from, and a Map ID (Map
# Management, JavaScript) which the map's advanced markers need.
# While developing, leave both empty: the map works with Google's DEMO_MAP_ID, watermarked "For development purposes
# only", with a dialog that can be closed. A key restricted to http://localhost:3000/* removes both.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
