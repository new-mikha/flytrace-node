{
  "lineWidth": 100,
  "indentWidth": 2,
  "newLineKind": "auto",
  "typescript": {
    "quoteStyle": "preferSingle",
    "semiColons": "always",
    "trailingCommas": "onlyMultiLine",
    "useBraces": "maintain",
    "singleBodyPosition": "nextLine",
    "bracePosition": "sameLine",
    "ifStatement.preferHanging": true,
    "ifStatement.bracePosition": "sameLineUnlessHanging",
    "forStatement.bracePosition": "sameLineUnlessHanging",
    "whileStatement.bracePosition": "sameLineUnlessHanging",
    "binaryExpression.operatorPosition": "sameLine",
    "conditionalExpression.operatorPosition": "nextLine",
    "binaryExpression.linePerExpression": true
  },
  "includes": [
    "server/**/*.{ts,tsx}",
    "db/**/*.ts",
    "public/js/**/*.js",
    "*.config.ts"
  ],
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/db/legacy/dump/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.1.wasm"
  ]
}
