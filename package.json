{
  "name": "flytrace-node",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "start": "node dist/server/src/index.js",
    "build": "tsc -p tsconfig.json && cp -R db/migrations dist/db/ && cp db/legacy/staging.sql db/legacy/transform.sql db/legacy/verify.sql dist/db/legacy/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:reset": "tsx db/reset.ts",
    "db:import-legacy": "tsx db/legacy/import-legacy.ts",
    "user:create": "tsx server/src/cli/create-user.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/formbody": "^9.0.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/session": "^11.1.4",
    "@fastify/static": "^10.1.7",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "argon2": "^0.45.1",
    "bootstrap": "^5.3.8",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "nodemailer": "^10.2.0",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "preact": "^11.0.1",
    "preact-render-to-string": "^6.8.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/qrcode": "^1.5.6",
    "pino-pretty": "^13.2.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.5"
  }
}
